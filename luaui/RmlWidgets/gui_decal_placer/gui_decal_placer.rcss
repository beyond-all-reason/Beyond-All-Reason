/* Decal Placer Library: extends the fp- styles from gui_feature_placer */

.dp-root {
	width: 13vw;
	min-width: 220dp;
	z-index: 901;
}

/* Decal tiles: the .dp-tile-host wrapper is 84dp x 84dp and .fp-feature-item fills it.
   The wrapper stays in the DOM so flex-wrap sizes correctly. */
.dp-root .dp-tile-host {
	width: 84dp;
	height: 84dp;
	margin: 2dp;
}

.dp-root .dp-tile-host > .fp-feature-item {
	width: 100%;
	height: 100%;
}

/* The decal preview img fills its thumb. Decals with real alpha (PNG/TGA) show the category
   tint through transparent pixels. Channel-encoded BMP atlases (mainscars, tracks, footprints)
   are opaque RGB and hide it until a bake converts their mask channels to alpha. */
.dp-root .fp-feature-thumb img {
	width: 100%;
	height: 100%;
}

/* Category tints: visible on alpha-channel decals (PNG/TGA). */
.dp-thumb-scars        { background-color: #6b4838; }
.dp-thumb-explosions   { background-color: #b04030; }
.dp-thumb-tracks       { background-color: #4a4a52; }
.dp-thumb-builds       { background-color: #406090; }
.dp-thumb-footprints   { background-color: #604838; }
.dp-thumb-scorch       { background-color: #2a2018; }
.dp-thumb-groundplates { background-color: #506060; }
.dp-thumb-other        { background-color: #4a4a4a; }
