.mh-root {
	position: absolute;
	width: 100vw;
	height: 100vh;
	display: flex;
	justify-content: center;
	align-items: flex-start;
	pointer-events: none;
}

/* Clear of the top bar and the first console lines. */
.mh-box {
	margin-top: 110dp;
	width: 640dp;
	max-width: 90vw;
	padding: 10dp 14dp;
	background-color: #16161ce6;
	border: 1dp #3e3e4a;
	border-radius: 6dp;
	font-size: 1.5rem;
	color: #f4f4f8;
}
