#define TA			// This is a TA script

#include "sfxtype.h"
#include "exptype.h"

piece  base, thrust, firepoint, bomb, basefirepoint;

static-var  statechg_DesiredState, statechg_StateChanging, detonating, releaseGravity, releasePitchTolerance, releaseHeadingTolerance, lastY, climb;

#define SIG_AIM				2

Go()
{
}

Stop()
{
}

#define BASEPIECE base
#define HITSPEED <105.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 3
#define MAXTILT 100

InitState()
{
	statechg_DesiredState = TRUE;
	statechg_StateChanging = FALSE;
}

RequestState(requestedstate, currentstate)
{
	if( statechg_StateChanging )
	{
		statechg_DesiredState = requestedstate;
		return (0);
	}
	statechg_StateChanging = TRUE;
	currentstate = statechg_DesiredState;
	statechg_DesiredState = requestedstate;
	while( statechg_DesiredState != currentstate )
	{
		if( statechg_DesiredState == 0 )
		{
			call-script Go();
			currentstate = 0;
		}
		if( statechg_DesiredState == 1 )
		{
			call-script Stop();
			currentstate = 1;
		}
	}
	statechg_StateChanging = FALSE;
}

TrackClimb()
{
	// AimWeapon1 needs the vertical speed. COB cannot read it directly.
	lastY = get UNIT_Y;
	while(TRUE)
	{
		sleep 1;
		climb = (get UNIT_Y) - lastY;
		lastY = lastY + climb;
	}
}

Create()
{
	hide thrust;
	call-script InitState();
	start-script TrackClimb();
}

SetReleaseWindowWeapon1(gravity, pitchTolerance, headingTolerance)
{
	releaseGravity = gravity;
	releasePitchTolerance = pitchTolerance;
	releaseHeadingTolerance = headingTolerance;
}

Activate()
{
	show thrust;
	start-script RequestState(0);
}

Deactivate()
{
	hide thrust;
	start-script RequestState(1);
}

// The weapon uses a generous range and tolerance that we then restrict to believable trajectories.
// Use the bomber's velocity to get the bomb's drop time: T = (vy + sqrt(vy^2 + 2 g h)) / g frames.
// Then, remove the bomber's pitch to get the angle below horizon of that drop: atan(h / (vh T)).
AimWeapon1(heading, pitch)
{
	var targetID, height, vy, vh, gravity, frames, reach, rise, nose;

	targetID = get TARGET_ID(1);
	if(targetID > 0)
	{
		height = (get UNIT_Y) - (get UNIT_Y(targetID));
	}
	else
	{
		height = (get UNIT_Y) - (get GROUND_HEIGHT(get UNIT_XZ)); // rough guess for ground targets
	}
	if(height < 0)
	{
		height = 0;
	}

	// Distances are in 1/1024 elmo to keep the products within COB's integer range.
	// Lengths enter COB as 1/65536 elmo. We work in 1/1024, so we divide by 64 here.
	height = height / 64;
	vy = climb / 64;
	vh = (get CURRENT_SPEED) / 64;
	vh = get SQRT(get MAX(vh * vh - vy * vy, 1));
	gravity = releaseGravity / 64;
	frames = (vy + (get SQRT(vy * vy + 2 * gravity * height))) * 1024 / gravity;
	reach = vh * frames / 1024;

	// 10496 (in 1/256) is 41 elmos, the distance between the base and thrust pieces.
	rise = ((get PIECE_Y(base)) - (get PIECE_Y(thrust))) / 256;
	nose = get ATAN(rise, get SQRT(get MAX(10496 * 10496 - rise * rise, 0)));

	if(releasePitchTolerance < (get ABS((get ATAN(height, reach)) + pitch + nose)))
	{
		return (FALSE);
	}
	if(releaseHeadingTolerance < (get ABS(heading)))
	{
		return (FALSE);
	}
	return (TRUE);
}

AimWeapon2()
{
	return (FALSE);
}

AimWeapon3()
{
	signal SIG_AIM;
	set-signal-mask SIG_AIM;
	sleep 10000;
	return (FALSE);
}

BlockShot1(targetID, block, userTarget)
{
	block = TRUE;
	emit-sfx 1024 + 1 from base;
	detonating = TRUE; // Killed reads this rather than inferring the cause of death from severity
	emit-sfx 4096 + 1 from base; //Weapon2 detonates the crawling bomb once weapon1 triggers
}

QueryWeapon1(piecenum)
{
	piecenum = firepoint;
}

AimFromWeapon1(piecenum)
{
	piecenum = firepoint;
}

FireWeapon2()
{
	return (1);
}

QueryWeapon2(piecenum)
{
	piecenum = basefirepoint;
}

AimFromWeapon2(piecenum)
{
	piecenum = base;
}

FireWeapon3()
{
	return (1);
}

QueryWeapon3(piecenum)
{
	piecenum = thrust;
}

AimFromWeapon3(piecenum)
{
	piecenum = base;
}

SweetSpot(piecenum)
{
	piecenum = base;
}

Killed(severity, corpsetype)
{
	// Drop the bomb when we detonated ourselves, or when a weak killing blow left the payload intact.
	if( detonating || severity <= 25 )
	{
		// The bomb uses this unit's model, so hide the airframe before launching it.
		hide base;
		hide thrust;
		hide firepoint;
		hide bomb;
		emit-sfx 2048 + 2 from firepoint; //Triggers kamikaze weapon after unit kills itself
		// Stay in the unit table until the bomb has landed, so its damage is credited to our team.
		sleep 3000;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 500 )
	{
		corpsetype = 3 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
    explode base type BITMAPONLY | NOHEATCLOUD;
	return corpsetype;
}
