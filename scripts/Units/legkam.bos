
#include "../recoil_common_includes.h"


piece base, thrust, firepoint, bomb, basefirepoint;

static-var  detonating;

#define BASEPIECE base
#define HITSPEED <105.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 3
#define MAXTILT 100

Create()
{
	hide thrust;
}

Activate()
{
	show thrust;
}

Deactivate()
{
	hide thrust;
}

AimWeapon1()
{
	return (FALSE);
}

AimWeapon2()
{
	return (FALSE);
}

AimWeapon3()
{
	signal SIGNAL_AIM3;
	set-signal-mask SIGNAL_AIM3;
	sleep 10000;
	return (FALSE);
}

FireWeapon1()
{
	sleep 500;
	emit-sfx 1024 + 1 from base;
	detonating = TRUE; // Killed reads this rather than inferring the cause of death from severity
	emit-sfx 4096 + 1 from base; //Weapon2 detonates the crawling bomb once weapon1 fires
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = thrust;
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = base;
}

FireWeapon2()
{
	return (1);
}

QueryWeapon2(pieceIndex)
{
	pieceIndex = basefirepoint;
}

AimFromWeapon2(pieceIndex)
{
	pieceIndex = base;
}

FireWeapon3()
{
	return (1);
}

QueryWeapon3(pieceIndex)
{
	pieceIndex = thrust;
}

AimFromWeapon3(pieceIndex)
{
	pieceIndex = base;
}

Killed(severity, corpsetype)
{
	// Drop the bomb when we detonated ourselves, or when a weak killing blow left the payload intact.
	if( detonating || severity <= 25 )
	{
		// The bomb uses this unit's model, so hide the airframe before launching it.
		hide base;
		hide thrust;
		hide firepoint;
		hide bomb;
		emit-sfx 2048 + 2 from firepoint; //Triggers kamikaze weapon after unit kills itself
		// Stay in the unit table until the bomb has landed, so its damage is credited to our team.
		sleep 3000;
		return (0);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 500 )
	{
		corpsetype = 3 ;
		emit-sfx 1024 from base;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
	explode base type BITMAPONLY | NOHEATCLOUD;
	return corpsetype;
}
