piece base, turretBase, turretStrut, gun, flarer, flarel, smoke1, smoke2;

static-var  statechg_DesiredState, statechg_StateChanging, whichGun, timeLeft, isfiring, gameframe, lastfired, fireTime, reloadTime, oldhead, aimAdj, oldsteerheading, cooldown, isFiring, restore_delay, gun_lasthead, gun_lastpitch;

// Signal definitions
// Signal definitions
#define SIGNAL_AIM1 256
#define SIGNAL_MOVE 1
#define SIGNAL_LIGHT	4
#define SIGNAL_RESTORE	8



#define VD_PIECE1 smoke1;
#define VD_PIECE2 smoke2;
#define VD_AMPHIBIOUS
#define VD_DIRTCEG 1024 + 1
#include "../vehicle_dirt_cegs.h"

Steering(heading, steery, currentSpeed)
{
	//signal SIGNAL_MOVE;
	//set-signal-mask SIGNAL_MOVE;
	while(1)
	{
		if (isFiring)
		{
			cooldown = cooldown + 1;
			if (cooldown > reloadTime)
			{
				if (whichGun == 0)
				{
						whichGun = 1;
				}
				else if (whichGun == 1)
				{
						whichGun = 0;
				}
				cooldown = 0;
				isFiring = 0;
				//start-script RestoreAfterDelay();
			}
		}
		heading = get HEADING;
		aimAdj = (heading - oldsteerheading);
		sleep 33;
		oldsteerheading = heading;
	}
}

#define BASEPIECE base
#define HITSPEED <45.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 7
#define MAXTILT 100
#define RECOIL_POWER 0
#include "../unit_hitbyweaponid_and_smoke.h"


#define TB_BASE base 
#define TB_TURNRATE <12.0> 
#define TB_TILT_X <0.20>
#define TB_BANK_Z <0.15> // Do not define this if you dont want banking
#include "../tilt_bank_mobileunit.h"

RestoreAfterDelay()
{
	set-signal-mask SIGNAL_AIM1;
	sleep restore_delay;
	start-script RestoreAfterDelayGun();
}

RestoreAfterDelayGun(addTime)
{
	signal SIGNAL_RESTORE;
	set-signal-mask SIGNAL_RESTORE;
	gun_lasthead = -1000000;
	gun_lastpitch = -1000000;
	aimAdj = 0;
	turn turretBase to y-axis <0.000000> speed <90.000000>;
	turn turretStrut to x-axis <0.000000> speed <50.000000>;
}

Create()
{
	start-script Steering();
	restore_delay = 500;
	timeLeft = 0;
    isfiring = 0;
	oldsteerheading = get HEADING;
	oldhead = 1000000;
	aimAdj = 0;
	cooldown = 0;
	isFiring = 0;
	fireTime = 54;
	lastfired = -1000000;
	whichGun = 0;
	return (0);
}

SetMaxReloadTime(reloadMS)
{
	reloadTime = reloadMS; // FIXME: xp scaling
}

SetSweepfireTimeWeapon1(fireTimeValue, reloadTimeValue)
{
	fireTime = fireTimeValue;
	reloadTime = reloadTimeValue;
}

StartMoving(reversing)
{
	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;
	start-script Vehicle_Dirt_Ceg();
	//START_TILTBANK;
}


StopMoving()
{
	signal SIGNAL_MOVE;
	//STOP_TILTBANK;
}


AimPrimary(heading, pitch)
{ 
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	turn turretBase to y-axis heading - aimAdj speed <65.000000>;
	turn turretStrut to x-axis <0.000000> - pitch speed <50.000000>;
	start-script RestoreAfterDelay();
	if (cooldown > fireTime)
	{
		return (0);
	}
	if ( (get ABS(gun_lasthead - heading)< <20>) AND (get ABS(gun_lastpitch - pitch)< <20>) )
	{
		gun_lasthead = heading;
		gun_lastpitch = pitch;
		return (1);
	}
	wait-for-turn turretBase around y-axis;
	wait-for-turn turretStrut around x-axis;
	gun_lasthead = heading;
	gun_lastpitch = pitch;
	return (1);
}

FirePrimary()
{
	isFiring = 1;
	gameframe = get(GAME_FRAME);
	lastfired = gameframe;
	if (whichGun == 0){
		//emit-sfx 1024 + 0  from flarer;
		sleep 2000;
		return(0);
	}

	if (whichGun == 1){
		//emit-sfx 1024 + 0  from flarel;
		sleep 2000;
		return(0);
	}
	return (0);
}

AimFromWeapon1(piecenum)
{
	if (whichGun == 0){
		piecenum = flarer;
		//whichGun = 1;
	}

	if (whichGun == 1){
		piecenum = flarel;
		//whichGun = 0;
	}
	return (0);
}

QueryWeapon1(piecenum)
{
	if (whichGun == 0){
		piecenum = flarer;
		//whichGun = 1;
	}

	if (whichGun == 1){
		piecenum = flarel;
		//whichGun = 0;
	}
	return (0);
}


Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		// explode base type BITMAPONLY | NOHEATCLOUD;
		// explode turretBase type BITMAPONLY | NOHEATCLOUD;
		// explode barrelPivot type BITMAPONLY | NOHEATCLOUD;
		// explode barrelMid type BITMAPONLY | NOHEATCLOUD;
		// explode barrelBack type FIRE | SMOKE | FALL | NOHEATCLOUD;
		//explode flare type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		// explode base type BITMAPONLY | NOHEATCLOUD;
		// explode turretBase type FIRE | SMOKE | FALL | NOHEATCLOUD;
		// explode barrelPivot type FALL | NOHEATCLOUD;
		// explode barrelMid type FIRE | SMOKE | FALL | NOHEATCLOUD;
		// explode barrelBack type FALL | NOHEATCLOUD;
		//explode flare type FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		// explode base type FIRE | SMOKE | FALL | NOHEATCLOUD;
		// explode turretBase type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		// explode barrelPivot type SMOKE | FALL | NOHEATCLOUD;
		// explode barrelMid type SMOKE | FALL | NOHEATCLOUD;
		// explode barrelBack type EXPLODE_ON_HIT | SMOKE | FALL | NOHEATCLOUD;
		//explode flare type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		// explode base type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		// explode turretBase type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		// explode barrelPivot type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		// explode barrelMid type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		// explode barrelBack type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		//explode flare type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	return corpsetype;
}
