
#include "../recoil_common_includes.h"

piece turretHeadingPivot,
turrretPitchPivot,
rightBarrel,
topBarrel,
base,
leftBarrel,
topFlare,
rightFlare,
leftFlare,
leftCannisterLight,
rightCannisterLight,
topBarrelLightA,
topBarrelLightB,
rightBarrelLight,
leftBarrelLight;

static-var  gun_1, restore_delay;

// Signal definitions
#define SIGNAL_MOVE 1
#define SIGNAL_AIM1 256


#define BASEPIECE base
#define HITSPEED <55.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 3
#define MAXTILT 100

#define TB_BASE base 
#define TB_TURNRATE <15.0> 
#define TB_TILT_X <0.1>
#define TB_BANK_Z <0.1> // Do not define this if you dont want banking
#include "../tilt_bank_mobileunit.h"


RockUnit(anglex, anglez)
{
	turn base to x-axis anglex speed <50.0>;
	turn base to z-axis <0> - anglez speed <50.0>;
	wait-for-turn base around z-axis;
	wait-for-turn base around x-axis;
	turn base to z-axis <0.0> speed <20.0>;
	turn base to x-axis <0.0> speed <20.0>;
}

Create()
{
	turn turrretPitchPivot to x-axis <-18> now;
	gun_1 = 0;
	restore_delay = 3000;
	call-script TB_Init();
}

StartMoving(reversing)
{
	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;

	START_TILTBANK;
}

StopMoving()
{
	signal SIGNAL_MOVE;

	STOP_TILTBANK;
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
		move topBarrel to y-axis [0] speed [10];
		move leftBarrel to y-axis [0] speed [10];
		move rightBarrel to y-axis [0] speed [10];
	turn turretHeadingPivot to y-axis <0.0> speed <40.0>;
	turn turrretPitchPivot to x-axis <-18.0> speed <40.0>;
	wait-for-turn turretHeadingPivot around y-axis;
	wait-for-turn turrretPitchPivot around x-axis;
}

SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
	    start-script ExecuteRestoreAfterDelay();
	}
}

RestoreAfterDelay()
{
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	if(heading < <90> AND heading > <-90>){	
		turn turretHeadingPivot to y-axis heading speed <40.0>;
		if(-1*pitch > <0>){
			move topBarrel to y-axis [1] speed [10];
			move leftBarrel to y-axis [1] speed [10];
			move rightBarrel to y-axis [1] speed [10];
			turn turrretPitchPivot to x-axis <0> speed <40.0>;
		}
		else if(-1*pitch > <-18> and -1*pitch < <0>){
			move topBarrel to y-axis [1] speed [10];
			move leftBarrel to y-axis [1] speed [10];
			move rightBarrel to y-axis [1] speed [10];
			turn turrretPitchPivot to x-axis -1*pitch speed <40.0>;
		}
		else {
			move topBarrel to y-axis [0] speed [10];
			move leftBarrel to y-axis [0] speed [10];
			move rightBarrel to y-axis [0] speed [10];
			turn turrretPitchPivot to x-axis -1*pitch speed <40.0>;
		}
		wait-for-turn turretHeadingPivot around y-axis;
		wait-for-turn turrretPitchPivot around x-axis;
		start-script RestoreAfterDelay();
		return (1);
	}
	else{
		return (0);
	}
}

FireWeapon1()
{
}

Shot1(){
	if( gun_1 == 0 )
	{
		move topBarrel to z-axis [-7] speed [60];
		emit-sfx 1024 + 0 from topFlare;
	}
	else if( gun_1 == 1 )
	{
		move leftBarrel to z-axis [-7] speed [60];
		emit-sfx 1024 + 0 from leftFlare;
	}
	else if( gun_1 == 2 )
	{
		move rightBarrel to z-axis [-7] speed [60];
		emit-sfx 1024 + 0 from rightFlare;
	}

	gun_1 = (gun_1 + 1) % 3;
	sleep 500;
	move topBarrel to z-axis [0] speed [2];
	move leftBarrel to z-axis [0] speed [2];
	move rightBarrel to z-axis [0] speed [2];
}

QueryWeapon1(pieceIndex)
{
	if( gun_1 == 0 )
	{
		pieceIndex = topFlare;
	}
	else if( gun_1 == 1 )
	{
		pieceIndex = leftFlare;
	}
	else if( gun_1 == 2 )
	{
		pieceIndex = rightFlare;
	}
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = turrretPitchPivot;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode turretHeadingPivot type BITMAPONLY | NOHEATCLOUD;
		explode turrretPitchPivot type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode turretHeadingPivot type FALL | NOHEATCLOUD;
		explode turrretPitchPivot type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode topBarrel type FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode base type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turretHeadingPivot type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turrretPitchPivot type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode topBarrel type FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		explode base type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turretHeadingPivot type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turrretPitchPivot type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode topBarrel type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode leftBarrel type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	return corpsetype;
}
