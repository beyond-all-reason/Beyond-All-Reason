
#include "../recoil_common_includes.h"

piece  base, rotorBottom, rotorTop;

static-var  resourceRate, Stunned;


SetStunned(State)
{
	Stunned = State;
	if (State) {
	    call-script Deactivate();
	}else{
	    call-script Activate();
	}
}

Create()
{
	resourceRate = 1500;
	SLEEP_UNTIL_UNITFINISHED;
}


#define BASEPIECE base
#define MAXTILT 0
#include "../unit_hitbyweaponid_and_smoke.h"

Activate()
{
	if (Stunned) {
		return(0);
	}
	set ARMORED to 0;
	spin rotorBottom around y-axis speed (resourceRate*2) accelerate <0.5>;
	spin rotorTop around y-axis speed (resourceRate*1) accelerate <0.5>;
}

Deactivate()
{
	stop-spin rotorBottom around y-axis decelerate <1>;
	stop-spin rotorTop around y-axis decelerate <1>;
	wait-for-turn rotorBottom around y-axis;
	set ARMORED to 1;
}

SetSpeed(windOrMetal)
{
	resourceRate = windOrMetal * 60;
	if (resourceRate > 0) call-script Activate(); // Because SetSpeed is called after Activate
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode rotorBottom type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode rotorTop type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode rotorBottom type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode rotorTop type FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode rotorTop type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode rotorBottom type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode base type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		explode rotorTop type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		explode rotorBottom type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		explode base type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
	return corpsetype;
}
