#include "../recoil_common_includes.h"

piece  base, ground, wake1, wake2, turret1, gun1, barrel1, flare1, turret2, gun2, barrel2, flare2, turret3, gun3, barrel3, flare3;

static-var  restore_delay, aimDir1;


#define RB_MASS 40
#define RB_LENGTH 8
#define RB_WIDTH 3
#define RB_PITCH_ACCELERATION 10
#define RB_ROLL_ACCELERATION 8
#define RB_RECOIL_ENERGY_1 700
#define RB_WAKE_PIECE wake1
#define RB_WAKE_PIECE2 wake2
#define RB_WAKE_CEG 1024 + 1

#include "../bar_ships_common.h"


Create()
{
	hide wake2;
	hide wake1;
	restore_delay = 3000;
	start-script InitRockBoat();
	SLEEP_UNTIL_UNITFINISHED;
	start-script BoatPhysics();
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	set-signal-mask 0;
	turn turret1 to y-axis <0.0> speed <20.0>;
	turn turret2 to y-axis <0.0> speed <20.0>;
	turn turret3 to y-axis <0.0> speed <20.0>;
}
SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
 	    start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

StartMoving(reversing)
{
}

StopMoving()
{
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	aimDir1 = heading;
	turn turret1 to y-axis heading speed <30.0>;
	turn gun1 to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <5.0>;
	wait-for-turn turret1 around y-axis;
	wait-for-turn gun1 around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon1()
{
	move barrel1 to z-axis [-1.400000] speed [500.0];
	emit-sfx 1024 + 0 from flare1;
	sleep 150;
	wait-for-move barrel1 along z-axis;
	move barrel1 to z-axis [0.0] speed [3.0];
	RB_RECOILBOAT(aimDir1, RB_RECOIL_ENERGY_1)
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = turret1;
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = flare1;
}

AimWeapon2(heading, pitch)
{
	signal SIGNAL_AIM2;
	set-signal-mask SIGNAL_AIM2;
	turn turret2 to y-axis heading speed <30.0>;
	turn gun2 to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <5.0>;
	wait-for-turn turret2 around y-axis;
	wait-for-turn gun2 around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon2()
{
	move barrel2 to z-axis [-1.400000] speed [500.0];
	emit-sfx 1024 + 0 from flare2;
	sleep 150;
	wait-for-move barrel2 along z-axis;
	move barrel2 to z-axis [0.0] speed [3.0];
}

AimFromWeapon2(pieceIndex)
{
	pieceIndex = turret2;
}

QueryWeapon2(pieceIndex)
{
	pieceIndex = flare2;
}

AimWeapon3(heading, pitch)
{
	signal SIGNAL_AIM3;
	set-signal-mask SIGNAL_AIM3;
	turn turret3 to y-axis heading speed <30.0>;
	turn gun3 to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <5.0>;
	wait-for-turn turret3 around y-axis;
	wait-for-turn gun3 around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon3()
{
	move barrel3 to z-axis [-1.400000] speed [500.0];
	emit-sfx 1024 + 0 from flare3;
	sleep 150;
	wait-for-move barrel3 along z-axis;
	move barrel3 to z-axis [0.0] speed [3.0];
}

AimFromWeapon3(pieceIndex)
{
	pieceIndex = turret3;
}

QueryWeapon3(pieceIndex)
{
	pieceIndex = flare3;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode wake2 type BITMAPONLY | BITMAP3 | NOHEATCLOUD;
		return (corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode wake2 type FALL | EXPLODE_ON_HIT | BITMAP3 | NOHEATCLOUD;
		return (corpsetype);
	}
	corpsetype = 3;
	explode wake1 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP2 | NOHEATCLOUD;
	explode wake2 type FALL | SMOKE | FIRE | EXPLODE_ON_HIT | BITMAP3 | NOHEATCLOUD;
	return corpsetype;
}
