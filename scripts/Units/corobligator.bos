#include "../recoil_common_includes.h"

piece base, necka, head, neckb, holder, flareaa, flareab, flareac, flaread, flareba, flarebb;

static-var missileIndex, rocketIndex, missilesFired, rocketsFired, missileWindow,
	lastShotFrame, lastSalvoFrame, gateWaitStart, lastAimFrame;

#define SIG_AIM 2
#define SIG_RESTORE 4

#define MAX_PITCH <30>
#define YAW_SPEED <25>
#define PITCH_SPEED <10>
#define COUNTER_SPEED <15>
#define RESTORE_DELAY 5000

// frames; must match obligator_rocket reloadtime 11.55
#define ROCKET_RELOAD 347
#define MISSILE_COUNT 8
#define ROCKET_COUNT 2
#define MISSILE_TUBES 4
#define ROCKET_TUBES 2
#define MISSILE_DELAY 53
#define CYCLE_RESET 180
#define GATE_TIMEOUT 75
#define NEW_ENGAGEMENT_GAP 45

ResetCycle()
{
	missilesFired = 0;
	rocketsFired = 0;
	missileIndex = 1;
	rocketIndex = 1;
}

RestoreAfterDelay()
{
	signal SIG_RESTORE;
	set-signal-mask SIG_RESTORE | SIG_AIM;
	sleep RESTORE_DELAY;
	turn necka to y-axis <0> speed YAW_SPEED;
	turn head to x-axis <0> speed PITCH_SPEED;
	turn neckb to x-axis <0> speed COUNTER_SPEED;
}

Create()
{
	hide flareaa;
	hide flareab;
	hide flareac;
	hide flaread;
	hide flareba;
	hide flarebb;
	missileIndex = 1;
	rocketIndex = 1;
	lastShotFrame = 0 - CYCLE_RESET;
	lastSalvoFrame = 0 - ROCKET_RELOAD;
	lastAimFrame = 0 - NEW_ENGAGEMENT_GAP;
}

AimWeapon1(heading, pitch)
{
	var p, frame;

	signal SIG_AIM;
	set-signal-mask SIG_AIM;

	p = pitch;
	if (p > MAX_PITCH)
	{
		p = MAX_PITCH;
	}
	if (p < 0 - MAX_PITCH)
	{
		p = 0 - MAX_PITCH;
	}

	turn necka to y-axis heading speed YAW_SPEED;
	turn head to x-axis 0 - p speed PITCH_SPEED;
	turn neckb to x-axis p speed COUNTER_SPEED;
	wait-for-turn necka around y-axis;
	wait-for-turn head around x-axis;
	start-script RestoreAfterDelay();

	frame = get GAME_FRAME;
	if (frame - lastShotFrame > CYCLE_RESET)
	{
		call-script ResetCycle();
	}
	if (frame - lastAimFrame > NEW_ENGAGEMENT_GAP)
	{
		gateWaitStart = frame;
	}
	lastAimFrame = frame;

	if ((rocketsFired >= ROCKET_COUNT) && (frame >= missileWindow))
	{
		return (1);
	}
	if ((frame - gateWaitStart > GATE_TIMEOUT) && (frame - lastSalvoFrame >= ROCKET_RELOAD))
	{
		return (1);
	}
	return (0);
}

AimFromWeapon1(piecenum)
{
	piecenum = head;
}

QueryWeapon1(piecenum)
{
	piecenum = flareaa;
	if (missileIndex == 2)
	{
		piecenum = flareab;
	}
	if (missileIndex == 3)
	{
		piecenum = flareac;
	}
	if (missileIndex == 4)
	{
		piecenum = flaread;
	}
}

// Shot runs per shot, before QueryWeapon picks the muzzle
Shot1()
{
	missilesFired = missilesFired + 1;
	if (missilesFired == 1)
	{
		lastSalvoFrame = get GAME_FRAME;
	}
	missileIndex = ((missilesFired - 1) % MISSILE_TUBES) + 1;
	lastShotFrame = get GAME_FRAME;
	if (missilesFired >= MISSILE_COUNT)
	{
		call-script ResetCycle();
	}
}

AimWeapon2(heading, pitch)
{
	return (1);
}

AimFromWeapon2(piecenum)
{
	piecenum = head;
}

QueryWeapon2(piecenum)
{
	piecenum = flareba;
	if (rocketIndex == 2)
	{
		piecenum = flarebb;
	}
}

Shot2()
{
	rocketsFired = rocketsFired + 1;
	rocketIndex = ((rocketsFired - 1) % ROCKET_TUBES) + 1;
	lastShotFrame = get GAME_FRAME;
	if (rocketsFired >= ROCKET_COUNT)
	{
		missileWindow = lastShotFrame + MISSILE_DELAY;
	}
}

Killed(severity, corpsetype)
{
	if (severity <= 50)
	{
		corpsetype = 1;
		explode head type FIRE | SMOKE | FALL;
		explode holder type FIRE | SMOKE | FALL;
		return (corpsetype);
	}
	corpsetype = 2;
	explode head type EXPLODE_ON_HIT | FIRE | SMOKE | FALL;
	explode holder type EXPLODE_ON_HIT | FIRE | SMOKE | FALL;
	explode necka type FIRE | SMOKE | FALL;
	return (corpsetype);
}
