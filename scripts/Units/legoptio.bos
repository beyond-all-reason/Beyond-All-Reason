
#include "../recoil_common_includes.h"

piece
base,
door1,
door2,
neck,
boom,
nano,
wake,
turret,
sleeve,
barrelA,
barrelB,
flareA1,
flareA2,
flareA3,
flareA4,
flareA5,
flareA6,
flareB1,
flareB2,
flareB3,
flareB4,
flareB5,
flareB6;

static-var  restore_delay, barrelIndex, Stunned;

#define RB_MASS 30
#define RB_LENGTH 7
#define RB_WIDTH 3
#define RB_PITCH_ACCELERATION 10
#define RB_ROLL_ACCELERATION 8
#define RB_WAKE_PIECE wake
#define RB_WAKE_CEG 1024 + 1

#include "../bar_ships_common.h"

ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	set-signal-mask 0;
	stop-spin barrelA around z-axis decelerate <30>;
	stop-spin barrelB around z-axis decelerate <30>;
	turn sleeve to x-axis <-30> speed <50>;
	spin turret around y-axis speed <30> accelerate <2>;
}
SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
	    start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

Create()
{
	start-script InitRockBoat();
	hide flareA1;
	hide flareA2;
	hide flareA3;
	hide flareA4;
	hide flareA5;
	hide flareA6;
	hide flareB1;
	hide flareB2;
	hide flareB3;
	hide flareB4;
	hide flareB5;
	hide flareB6;
	barrelIndex = 1;
	restore_delay = 3000;
	set-signal-mask SIGNAL_AIM1;
	SLEEP_UNTIL_UNITFINISHED;
	start-script BoatPhysics();
	start-script RestoreAfterDelay();
}

StartMoving(reversing)
{
}

StopMoving()
{
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	stop-spin turret around y-axis;
	turn turret to y-axis heading speed <200.0>;
	turn sleeve to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <200.0>;
	wait-for-turn turret around y-axis;
	start-script RestoreAfterDelay();
	return (1);
}

QueryWeapon1(pieceIndex)
{
	if(barrelIndex==1) pieceIndex = flareB1;
	if(barrelIndex==2) pieceIndex = flareA1;
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = sleeve;
}

FireWeapon1()
{
	//looks like intentionally no visual flares on rocket type AA?

	if(barrelIndex==1){
		spin barrelA around z-axis speed <900.0>;
		stop-spin barrelB around z-axis decelerate <50>;
		stop-spin barrelA around z-axis decelerate <30>;
	}
	if(barrelIndex==2){
		spin barrelB around z-axis speed <-900.0>;
		stop-spin barrelA around z-axis decelerate <50>;
		stop-spin barrelB around z-axis decelerate <30>;
	}
	++barrelIndex;
	if(barrelIndex==3){
		barrelIndex = 1;
	}
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode door1 type BITMAPONLY | NOHEATCLOUD;
		explode neck type BITMAPONLY | NOHEATCLOUD;
		explode nano type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode door1 type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode neck type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode nano type FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode base type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode door1 type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode neck type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode boom type SMOKE | FALL | NOHEATCLOUD;
		explode nano type FIRE | SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
	explode base type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
	explode door1 type FIRE | SMOKE | FALL | NOHEATCLOUD;
	explode neck type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	explode boom type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	explode nano type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	return corpsetype;
}
