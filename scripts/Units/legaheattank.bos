#include "../recoil_common_includes.h"

//piece  base, flare, turret, sleeve, barrel, gun, turretl, barrell, flarel, turretr, barrelr, flarer;
//piece base, turretBase, gun, gearR, gearL, coverR, coverL;
piece base, turretBase, turretStrut, gun, flarer, flarel;

static-var restore_delay, whichGun;

// Signal definitions
#define SIGNAL_AIM1 256


#define BASEPIECE base
#define HITSPEED <55.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 4
#define MAXTILT 100

Create()
{
	restore_delay = 3000;
	whichGun = 0;
	start-script RestoreAfterDelay();
}

lua_UnitScriptLight(lightIndex, count)
{
	return 0;
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	turn turretBase to y-axis <0.0> speed <40>;
	turn turretStrut to x-axis <0.0> speed <40>;
	wait-for-turn turretBase around y-axis;
}
SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
	    start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	set-signal-mask SIGNAL_AIM1;
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	turn turretBase to y-axis heading speed <80>;
	turn turretStrut to x-axis <0.0> - pitch speed <80>;
	wait-for-turn turretBase around y-axis;
	wait-for-turn turretStrut around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon1()
{
	if (whichGun == 0){
		call-script lua_UnitScriptLight(1, whichGun);
		whichGun = 1;
		return(0);
	}

	if (whichGun == 1){
		call-script lua_UnitScriptLight(2, whichGun);
		whichGun = 0;
		return(0);
	}
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = gun;
}

QueryWeapon1(pieceIndex)
{
	if (whichGun == 0){
		pieceIndex = flarer;
	}

	if (whichGun == 1){
		pieceIndex = flarel;
	}
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		return(corpsetype);
	}
	corpsetype = 3 ;
	return corpsetype;
}
