#include "../recoil_common_includes.h"

//piece  base, flare, turret, sleeve, barrel, gun, turretl, barrell, flarel, turretr, barrelr, flarer;
//piece base, turretBase, gun, gearR, gearL, coverR, coverL;
piece base, turretBase, turretStrut, gun, flarer, flarel, smoke1, smoke2;

static-var whichGun, isFiring, fireTime, reloadTime, aimAdj, oldsteerheading, cooldown, restore_delay, gun_lasthead, gun_lastpitch;

#define TURRET_SPEED_WEAPONS 1
#include "../unitDefsTurretSpeeds.h"

// Signal definitions
#define SIGNAL_AIM1 256
#define SIGNAL_MOVE 1


#define VD_PIECE1 smoke1
#define VD_PIECE2 smoke2
#define VD_AMPHIBIOUS
#define VD_DIRTCEG 1024 + 1
#include "../vehicle_dirt_cegs.h"

Steering(heading)
{
	while(1)
	{
		if (isFiring)
		{
			cooldown = cooldown + 1;
			if (cooldown > reloadTime)
			{
				whichGun = !whichGun;
				cooldown = 0;
				isFiring = 0;
			}
		}
		heading = get HEADING;
		aimAdj = (heading - oldsteerheading);
		sleep 33;
		oldsteerheading = heading;
	}
}

#define BASEPIECE base
#define HITSPEED <45.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 7
#define MAXTILT 100
#include "../unit_hitbyweaponid_and_smoke.h"


#define TB_BASE base 
#define TB_TURNRATE <12.0> 
#define TB_TILT_X <0.20>
#define TB_BANK_Z <0.15> // Do not define this if you dont want banking
#include "../tilt_bank_mobileunit.h"

RestoreAfterDelay()
{
	set-signal-mask SIGNAL_AIM1;
	sleep restore_delay;
	start-script RestoreAfterDelayGun();
}

RestoreAfterDelayGun()
{
	signal SIGNAL_IDLE;
	set-signal-mask SIGNAL_IDLE;
	gun_lasthead = -1000000;
	gun_lastpitch = -1000000;
	aimAdj = 0;
	turn turretBase to y-axis <0.0> speed <90.0>;
	turn turretStrut to x-axis <0.0> speed <50.0>;
}

Create()
{
	Weapon1TurretX = <50.0>;
	Weapon1TurretY = <65.0>;
	start-script Steering();
	restore_delay = 500;
	oldsteerheading = get HEADING;
	aimAdj = 0;
	cooldown = 0;
	isFiring = 0;
	fireTime = 54;
	whichGun = 0;
	call-script TB_Init();
}

SetMaxReloadTime(reloadMS)
{
	reloadTime = reloadMS; // FIXME: xp scaling
}

SetSweepfireTimeWeapon1(fireTimeValue, reloadTimeValue)
{
	fireTime = fireTimeValue;
	reloadTime = reloadTimeValue;
}

StartMoving(reversing)
{
	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;
	start-script Vehicle_Dirt_Ceg();
	START_TILTBANK;
}


StopMoving()
{
	signal SIGNAL_MOVE;
	STOP_TILTBANK;
}


AimWeapon1(heading, pitch)
{
	var pitchSpeed, deltaHeading;
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	// Turn the pitch and heading together
	pitchSpeed = Weapon1TurretX;
	deltaHeading = get ABS(gun_lasthead - heading);
	if ((deltaHeading > <1>) AND (deltaHeading < <20>))
	{
		pitchSpeed = Weapon1TurretY * (get ABS(gun_lastpitch - pitch)) / deltaHeading;
		if (pitchSpeed > Weapon1TurretX) pitchSpeed = Weapon1TurretX;
		if (pitchSpeed < <5>) pitchSpeed = <5>;
	}
	turn turretBase to y-axis heading - aimAdj speed Weapon1TurretY;
	turn turretStrut to x-axis <0.0> - pitch speed pitchSpeed;
	start-script RestoreAfterDelay();
	if (cooldown > fireTime)
	{
		return (0);
	}
	if ( (get ABS(gun_lasthead - heading)< <20>) AND (get ABS(gun_lastpitch - pitch)< <20>) )
	{
		gun_lasthead = heading;
		gun_lastpitch = pitch;
		return (1);
	}
	wait-for-turn turretBase around y-axis;
	wait-for-turn turretStrut around x-axis;
	gun_lasthead = heading;
	gun_lastpitch = pitch;
	return (1);
}

FireWeapon1()
{
	isFiring = 1;
	if (whichGun == 0)
	{
		sleep 2000;
		return (0);
	}

	if (whichGun == 1)
	{
		sleep 2000;
		return (0);
	}
}

AimFromWeapon1(pieceIndex)
{
	if (whichGun == 0)
	{
		pieceIndex = flarer;
	}

	if (whichGun == 1)
	{
		pieceIndex = flarel;
	}
}

QueryWeapon1(pieceIndex)
{
	if (whichGun == 0)
	{
		pieceIndex = flarer;
	}

	if (whichGun == 1)
	{
		pieceIndex = flarel;
	}
}


Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		return(corpsetype);
	}
	corpsetype = 3 ;
	return corpsetype;
}
