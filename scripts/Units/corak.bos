       rleg, rfoot, lleg, lfoot, lthigh, rthigh,lknee,rknee, aimy1, aimx1;

static-var  isAiming, gun_1, moveSpeed, currentSpeed, curHead1, curPitch1, weaponReady;


//#define DEBUG
#include "../debug.h"

#include "../unitDefsTurretSpeeds.h";


#define VA_MAX_ANIM_TIME 100
static-var isMoving, maxSpeed;
#include "corak_walk.h"

