#include "../../recoil_common_includes.h"

piece  Chassis, ban1, ban1Flare1, ban1Flare2, ban2, ban2Flare1, ban2Flare2, FlamePivotXY, FlamePivotZ, Flamer, FlamerFlare1, FlamerFlare2, Turret, Barrel, BarrelExit, BarrelFlare1, BarrelFlare2, smoke1, smoke2;

static-var  restore_delay, last_ban1_heading, last_ban2_heading, lastfired, BarrelLastFired, Ban1LastFired, Ban2LastFired, FlamerLastFired;

// Signal definitions
#define SIGNAL_AIM1 256
#define SIGNAL_AIM2 512
#define SIGNAL_AIM3 1024
#define SIGNAL_MOVE 1

#define VD_PIECE1 smoke1
#define VD_PIECE2 smoke2
#define VD_DIRTCEG 1024 + 1
#include "../../vehicle_dirt_cegs.h"

#define BASEPIECE Chassis
#define HITSPEED <45.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 10
#define MAXTILT 100
#include "../../unit_hitbyweaponid_and_smoke.h"

#define TB_BASE Chassis
#define TB_TURNRATE <25.0>
#define TB_TILT_X <0.15>
#define TB_BANK_Z <0.15> // Do not define this if you dont want banking
#include "../../tilt_bank_mobileunit.h"

RockUnit(anglex, anglez)
{
	if (lastfired==1) {
		turn Chassis to x-axis anglex speed <50.005495>;
		turn Chassis to z-axis <0> - anglez speed <50.005495>;
		wait-for-turn Chassis around z-axis;
		wait-for-turn Chassis around x-axis;
		turn Chassis to z-axis <0.0> speed <20.0>;
		turn Chassis to x-axis <0.0> speed <20.0>;
	}
}

Create()
{
	hide smoke1;
	hide smoke2;
	lastfired = 0;
	BarrelLastFired = 1;
	Ban1LastFired = 1;
	Ban2LastFired = 1;
	FlamerLastFired = 1;
	restore_delay = 3000;
	call-script TB_Init();
}

StartMoving(reversing)
{
	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;
	start-script Vehicle_Dirt_Ceg();
	START_TILTBANK;
}

StopMoving()
{
	signal SIGNAL_MOVE;
	STOP_TILTBANK;
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	turn Turret to y-axis <0.0> speed <35.005495>;
	turn Barrel to x-axis <0.0> speed <15.0>;
}

SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
	    start-script ExecuteRestoreAfterDelay();
	}
}

RestoreAfterDelay()
{
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

RestoreAfterDelay_ban1()
{
	set-signal-mask SIGNAL_AIM2; //ensures restore animation is killed if this weapon is aimed
	sleep restore_delay;
	//large negative values to let wait-for-turn happen on first target
	last_ban1_heading = -1000000;
	turn ban1 to y-axis <0> speed <90>;
	turn ban1 to x-axis <0.0> speed <15>;
}

RestoreAfterDelay_ban2()
{
	set-signal-mask SIGNAL_AIM3; //ensures restore animation is killed if this weapon is aimed
	sleep restore_delay;
	//large negative values to let wait-for-turn happen on first target
	last_ban2_heading = -1000000;
	turn ban2 to y-axis <0> speed <90>;
	turn ban2 to x-axis <0.0> speed <15>;
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	turn Turret to y-axis heading speed <40.0>;
	turn Barrel to x-axis <0.0> - pitch speed <45.0>;
	wait-for-turn Turret around y-axis;
	wait-for-turn Barrel around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon1()
{
	lastfired = 1;
	if ( (BarrelLastFired==2) )
	{
		emit-sfx 1024 + 0 from BarrelFlare1;
		move BarrelExit to z-axis [-2.400000] speed [500.0];
		emit-sfx 1024 + 0 from BarrelFlare1;
		wait-for-move BarrelExit along z-axis;
		move BarrelExit to z-axis [0.0] speed [3.0];
		BarrelLastFired=1;
	}
	else
	{
		emit-sfx 1024 + 0 from BarrelFlare2;
		move BarrelExit to z-axis [-2.400000] speed [500.0];
		emit-sfx 1024 + 0 from BarrelFlare2;
		wait-for-move BarrelExit along z-axis;
		move BarrelExit to z-axis [0.0] speed [3.0];
		BarrelLastFired=2;
	}
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = Turret;
}

QueryWeapon1(pieceIndex)
{
	if ( (BarrelLastFired>1) )
	{
		pieceIndex = BarrelFlare1;
	}
	else
	{
		pieceIndex = BarrelFlare2;
	}
}

//left
AimWeapon2(heading, pitch)
{
	// logic to restrict turret rotation due to unitdef maxangledif
	// maxangledif=180 = 0 to 180 degrees = 0 to 32,768
	// does no turn animation if the target heading is out of firing arc
	// out of firing arc aim calls happen during "preaiming" logic
	if ( (heading<0) )
	{
		return (0);
	}
	signal SIGNAL_AIM2;
	set-signal-mask SIGNAL_AIM2;

	turn ban1 to y-axis heading speed <120>;
	// if weapon will take more than 1 frame to turn to new angle, wait for turn
	if ( (get ABS(last_ban1_heading - heading) > 720) )
	{
		// seems to take 3 frames for wait-for-turn to process
		wait-for-turn ban1 around y-axis;
	}
	last_ban1_heading = heading;

	turn ban1 to x-axis <0.0> - pitch speed <80.0>;
	wait-for-turn ban1 around x-axis;

	start-script RestoreAfterDelay_ban1();

	return (1);
}

FireWeapon2()
{
	lastfired = 2;
	if (Ban1LastFired>1)
	{
		Ban1LastFired=1;
	}
	else
	{
		Ban1LastFired=2;
	}
}

AimFromWeapon2(pieceIndex)
{
	pieceIndex = ban1;
}

QueryWeapon2(pieceIndex)
{
	if (Ban1LastFired>1)
	{
		pieceIndex = ban1Flare1;
	}
	else
	{
		pieceIndex = ban1Flare2;
	}
}

AimWeapon3(heading, pitch)
{
	// logic to restrict turret rotation due to unitdef maxangledif
	// maxangledif=180 = -180 to 0 degrees = -32,768 to 0
	// does no turn animation if the target heading is out of firing arc
	// out of firing arc aim calls happen during "preaiming" logic
	if ( (heading>0) )
	{
		return (0);
	}
	signal SIGNAL_AIM3;
	set-signal-mask SIGNAL_AIM3;
	turn ban2 to y-axis heading speed <120>;
	// if weapon will take more than 1 frame to turn to new angle, wait for turn
	if ( (get ABS(last_ban2_heading - heading)>720) )
	{
		// seems to take 3 frames for wait-for-turn to process
		wait-for-turn ban2 around y-axis;
	}
	last_ban2_heading=heading;

	turn ban2 to x-axis <0.0> - pitch speed <80.0>;
	wait-for-turn ban2 around x-axis;

	start-script RestoreAfterDelay_ban2();
	return (1);
}

FireWeapon3()
{
	lastfired = 3;
	if (Ban2LastFired>1)
	{
		Ban2LastFired=1;
	}
	else
	{
		Ban2LastFired=2;
	}
}

AimFromWeapon3(pieceIndex)
{
	pieceIndex = ban2;
}

QueryWeapon3(pieceIndex)
{
	if (Ban2LastFired>1)
	{
		pieceIndex = ban2Flare1;
	}
	else
	{
		pieceIndex = ban2Flare2;
	}
}

AimWeapon4(heading, pitch)
{
	if ( (heading<-11000) or (heading>11000) )
	{
		return (0);
	}
	if ( (pitch<-16000) or (pitch>16000) )
	{
		return (0);
	}

	turn FlamePivotXY to y-axis heading speed <120>;
	turn FlamePivotZ to x-axis pitch speed <80>;
	wait-for-turn FlamePivotXY around y-axis;
	wait-for-turn FlamePivotZ around x-axis;

	return (1);
}

FireWeapon4()
{
	lastfired = 4;
	if (FlamerLastFired>1)
	{
		FlamerLastFired=1;
	}
	else
	{
		FlamerLastFired=2;
	}
}

AimFromWeapon4(pieceIndex)
{
	pieceIndex = FlamePivotXY;
}

QueryWeapon4(pieceIndex)
{
	if ( (FlamerLastFired>1) )
	{
		pieceIndex = FlamerFlare1;
	}
	else
	{
		pieceIndex = FlamerFlare2;
	}
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode Chassis type BITMAPONLY | NOHEATCLOUD;
		explode Turret type BITMAPONLY | NOHEATCLOUD;
		explode Barrel type BITMAPONLY | NOHEATCLOUD;
		explode BarrelExit type BITMAPONLY | NOHEATCLOUD;
		explode ban1 type BITMAPONLY | NOHEATCLOUD;
		explode ban2 type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode Chassis type BITMAPONLY | NOHEATCLOUD;
		explode Turret type FIRE | SMOKE | NOHEATCLOUD;
		explode Barrel type FIRE | SMOKE | NOHEATCLOUD;
		explode BarrelExit type FIRE | SMOKE | NOHEATCLOUD;
		explode ban1 type FIRE | SMOKE | NOHEATCLOUD;
		explode ban2 type FIRE | SMOKE | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode Chassis type BITMAPONLY | NOHEATCLOUD;
		explode Turret type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode Barrel type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode BarrelExit type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode ban1 type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode ban2 type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		explode Chassis type BITMAPONLY | NOHEATCLOUD;
		explode Turret type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode Barrel type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode BarrelExit type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode ban1 type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
		explode ban2 type EXPLODE_ON_HIT | SMOKE | NOHEATCLOUD;
	return corpsetype;
}
