#include "../recoil_common_includes.h"

piece body, mount, gun, ammo, barrel, lTyre, rTyre, flare;

static-var  restore_delay, oldHeading, Stunned, curHead1, curPitch1;

#define TURRET_SPEED_WEAPONS 1
#include "../unitDefsTurretSpeeds.h"



#define BASEPIECE body
#define HITSPEED <55.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 1
#define MAXTILT 100
#include "../unit_hitbyweaponid_and_smoke.h"

#define TB_BASE body
#define TB_TURNRATE <35.0>
#define TB_TILT_X <-0.4>
#define TB_BANK_Z <0.2> // Do not define this if you dont want banking
#include "../tilt_bank_mobileunit.h"

Create()
{
	Weapon1TurretX = <300.0>;
	Weapon1TurretY = <300.0>;
	hide flare;
	oldHeading = get HEADING;
	call-script TB_Init();
	SLEEP_UNTIL_UNITFINISHED;
	restore_delay = 1500;
	start-script RestoreAfterDelay();
}

Steering(heading, steery, currentSpeed)
{
	while(1)
	{
		heading = get HEADING;
		steery = WRAPDELTA(heading - oldHeading)*3/2;
		turn body to y-axis steery speed <120>;
		currentSpeed = <5.5> *((get CURRENT_SPEED) * 100 / get MAX_SPEED);
		if (currentSpeed < <100>) currentSpeed = <100>;
		spin rTyre around x-axis speed currentSpeed;
		spin lTyre around x-axis speed currentSpeed;
		sleep 66;
		oldHeading = heading;
	}
}

StopMoving()
{
	signal SIGNAL_TURNON;
	turn body to y-axis <0> speed <120>;
	stop-spin rTyre around x-axis;
	stop-spin lTyre around x-axis;
	
	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;
	STOP_TILTBANK;
}

StartMoving(reversing)
{
	signal SIGNAL_TURNON;
	set-signal-mask SIGNAL_TURNON;
	oldHeading = get HEADING;
	start-script Steering();


	signal SIGNAL_MOVE;
	set-signal-mask SIGNAL_MOVE;
	START_TILTBANK;
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

ExecuteRestoreAfterDelay()
{
	if (Stunned) {
		return (1);
	}
	set-signal-mask SIGNAL_AIM1;

	var done;
	var delta;

	while (!done){
		done = TRUE;
		delta = WRAPDELTA(0 - curHead1);
		if (ABSOLUTE_GREATER_THAN(delta,(<150.0> / 30))) {
			curHead1 = curHead1 + SIGN(delta) * (<150.0> / 30);
			done = FALSE;
		}else{
			curHead1 = 0;
		}
		delta = WRAPDELTA(0 - curPitch1);
		if (ABSOLUTE_GREATER_THAN(delta,(<150.0> / 30))) {
			curPitch1 = curPitch1 + SIGN(delta) * (<150.0> / 30);
			done = FALSE;
		}else{
			curPitch1 = 0;
		}
		turn mount to y-axis curHead1 speed <150.0>;
		turn gun to x-axis <0.0> - curPitch1 speed <150.0>;
		if (!done) {
			sleep 1;
		}
	}
}
SetStunned(State)
{
	Stunned = State;
	if (!Stunned) {
		set-signal-mask SIGNAL_AIM1;
		start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	set-signal-mask SIGNAL_AIM1;
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;

	var canShoot;
	var delta;
	var nextHead;
	var nextPitch;

	while (!canShoot){
		canShoot = TRUE;
		delta = WRAPDELTA(heading - curHead1);
		if (ABSOLUTE_GREATER_THAN(delta,(Weapon1TurretY / 30))) {
			nextHead = WRAPDELTA(curHead1 + SIGN(delta) * (Weapon1TurretY / 30));
			canShoot = FALSE;
		}else{
			nextHead = heading;
		}
		delta = WRAPDELTA(pitch - curPitch1);
		if (ABSOLUTE_GREATER_THAN(delta,(Weapon1TurretX / 30))) {
			nextPitch = WRAPDELTA(curPitch1 + SIGN(delta) * (Weapon1TurretX / 30));
			canShoot = FALSE;
		}else{
			nextPitch = pitch;
		}
		turn mount to y-axis nextHead speed Weapon1TurretY;
		turn gun to x-axis <0.0> - nextPitch speed Weapon1TurretX;
		if (!canShoot) {
			sleep 1;
		}
		curHead1 = nextHead;
		curPitch1 = nextPitch;
	}

	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon1()
{
	move barrel to z-axis [-2.0] speed [500.0];
	sleep 400;
	move barrel to z-axis [0.0] speed [3.0];
}

Shot1()
{
	emit-sfx 1024 + 0 from flare;
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = flare;
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = barrel;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode body type BITMAPONLY | NOHEATCLOUD;
		explode mount type BITMAPONLY | NOHEATCLOUD;
		explode gun type FIRE | SMOKE | FALL | SHATTER | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode body type BITMAPONLY | NOHEATCLOUD;
		explode mount type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode gun type FIRE | SMOKE | FALL | SHATTER | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode body type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode mount type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode gun type EXPLODE_ON_HIT | SMOKE | FALL | SHATTER | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		explode body type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode mount type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode gun type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | SHATTER | NOHEATCLOUD;
	return corpsetype;
}
