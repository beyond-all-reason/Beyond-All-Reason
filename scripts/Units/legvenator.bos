#include "../recoil_common_includes.h"

piece  base, tailfins, barrel, lblades, rblades,
       flare, lthrust, rthrust;

#define BASEPIECE base
#define HITSPEED <105.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 1
#define MAXTILT 100

#define BARRELROLLSPEEED <200>
#include "../air_barrelroll.h"

Create()
{
	hide lthrust;
	hide rthrust;
	hide flare;
	start-script BarrelRoll();
}

Activate()
{
	show lthrust;
	show rthrust;

	move tailfins to z-axis [-8] speed [6];
	move barrel to z-axis [8] speed [6];
	move base to y-axis [0] speed [6];
	sleep 15;
}

Deactivate()
{
	hide lthrust;
	hide rthrust;

	move tailfins to z-axis [0] speed [6];
	move barrel to z-axis [0] speed [6];
	move base to y-axis [2] speed [6];
	sleep 9;
}

AimWeapon1(heading, pitch)
{
	return (1);
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = flare;
}

FireWeapon1()
{
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode base type BITMAPONLY | NOHEATCLOUD;

		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode base type BITMAPONLY | NOHEATCLOUD;

		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode base type BITMAPONLY | NOHEATCLOUD;

		return(corpsetype);
	}
	corpsetype = 3 ;
		explode base type BITMAPONLY | NOHEATCLOUD;

	return corpsetype;
}
