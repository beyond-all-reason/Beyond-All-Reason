#include "../recoil_common_includes.h"

piece base, wake1, wake2, turret1, sleevea, barrela, flarea, turret2, sleeve2, barrel1, flare1, barrel2, flare2;

static-var  restore_delay, aimDir1, aimDir2, aimDir3;


#define RB_MASS 40
#define RB_LENGTH 8
#define RB_WIDTH 3
#define RB_PITCH_ACCELERATION 10
#define RB_ROLL_ACCELERATION 8
#define RB_RECOIL_ENERGY_1 700
#define RB_RECOIL_ENERGY_2 700
#define RB_RECOIL_ENERGY_3 700
#define RB_WAKE_PIECE wake1
#define RB_WAKE_PIECE2 wake2
#define RB_WAKE_CEG 1024 + 0

#include "../bar_ships_common.h"


Create()
{
	hide wake2;
	hide wake1;
	restore_delay = 3000;
	start-script InitRockBoat();
	SLEEP_UNTIL_UNITFINISHED;
	start-script BoatPhysics();
}

SetMaxReloadTime(reloadMS)
{
	restore_delay = reloadMS * 2;
}

static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	set-signal-mask 0;
	turn turret1 to y-axis <0.0> speed <180.0>;
	turn turret2 to y-axis <0.0> speed <180.0>;
}
SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
   	    start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	sleep restore_delay;
	start-script ExecuteRestoreAfterDelay();
}

StartMoving(reversing)
{
}

StopMoving()
{
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	aimDir1 = heading;
	turn turret1 to y-axis heading speed <170.0>;
	turn sleevea to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <80.0>;
	wait-for-turn turret1 around y-axis;
	wait-for-turn sleevea around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon1()
{
	emit-sfx 1024 + 0 from flare1;
	RB_RECOILBOAT(aimDir1, RB_RECOIL_ENERGY_1);
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = turret1;
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = flarea;
}

AimWeapon2(heading, pitch)
{
	signal SIGNAL_AIM2;
	set-signal-mask SIGNAL_AIM2;
	aimDir2 = heading;
	turn turret2 to y-axis heading speed <170.0>;
	turn sleeve2 to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <80.0>;
	wait-for-turn turret2 around y-axis;
	wait-for-turn sleeve2 around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

FireWeapon2()
{
	emit-sfx 1024 + 0 from flare1;
	RB_RECOILBOAT(aimDir2, RB_RECOIL_ENERGY_2);
}

AimFromWeapon2(pieceIndex)
{
	pieceIndex = turret2;
}

QueryWeapon2(pieceIndex)
{
	pieceIndex = flare1;
}

//second barrel on rear gun, slaved to weapon 2
AimWeapon3(heading, pitch)
{
	aimDir3 = heading;
	turn turret2 to y-axis heading speed <170.0>;
	turn sleeve2 to x-axis RB_AIMPITCHCORRECTION(heading) - pitch speed <80.0>;
	wait-for-turn turret2 around y-axis;
	wait-for-turn sleeve2 around x-axis;
	return (1);
}

FireWeapon3()
{
	emit-sfx 1024 + 0 from flare2;
	RB_RECOILBOAT(aimDir3, RB_RECOIL_ENERGY_3);
}

AimFromWeapon3(pieceIndex)
{
	pieceIndex = turret2;
}

QueryWeapon3(pieceIndex)
{
	pieceIndex = flare2;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1;
		explode base type BITMAPONLY | BITMAP3 | NOHEATCLOUD;
		return (corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2;
		explode base type BITMAPONLY | BITMAP3 | NOHEATCLOUD;
		return (corpsetype);
	}
	corpsetype = 3;
	explode base type BITMAPONLY | BITMAP3 | NOHEATCLOUD;
	return corpsetype;
}
