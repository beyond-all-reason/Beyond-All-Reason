
#include "../recoil_common_includes.h"

piece  base, turret, gun, barrel, flare, wake, fan1, fan2, radar1, radar2;

// Signal definitions
#define SIGNAL_AIM1 256
#define SIGNAL_SHOOT1 16


#define HOVER_BASE base
#define HOVER_BANKSPEED <10>
#define HOVER_WOBBLE_PERIOD 55
#define HOVER_WOBBLE_AMPLITUDE [0.8]
#define HOVER_WAKEPIECE wake
#define HOVER_IDLE_SFX 1024 + 2
#define HOVER_WAKE_SFX_1 1024 + 0
#define HOVER_WAKE_SFX_2 1024 + 1
#include "../bar_hovercraft_common.h"


#define BASEPIECE base
#define HITSPEED <35.0>
//how 'heavy' the unit is, on a scale of 1-10
#define UNITSIZE 2
#define MAXTILT 100

#include "../unit_hitbyweaponid_and_smoke.h"

Create()
{
	hide wake;
	hide flare;
	turn gun to x-axis <-20.0> speed <25.0>;
	turn radar1 to x-axis <-20.0> speed <25.0>;
	SLEEP_UNTIL_UNITFINISHED;
	spin fan1 around y-axis speed <-300> accelerate <30>;
	spin fan2 around y-axis speed <-300> accelerate <30>;
	spin radar2 around y-axis speed <60> accelerate <5>;
	start-script HoverCraftMotion();
}


static-var  Stunned;
ExecuteRestoreAfterDelay()
{
    if (Stunned) {
        return (1);
    }
	turn turret to y-axis <0.0> speed <190.0>;
	turn gun to x-axis <-20.0> speed <25.0>;
	turn radar1 to x-axis <-20.0> speed <25.0>;
	stop-spin barrel around z-axis decelerate <5.0>;
}

SetStunned(State)
{
    Stunned = State;
	if (!Stunned) {
	    start-script ExecuteRestoreAfterDelay();
	}
}
RestoreAfterDelay()
{
	signal SIGNAL_SHOOT1;
	set-signal-mask SIGNAL_SHOOT1;
	sleep 5000;
	start-script ExecuteRestoreAfterDelay();
}

AimWeapon1(heading, pitch)
{
	signal SIGNAL_AIM1;
	set-signal-mask SIGNAL_AIM1;
	turn turret to y-axis heading speed <370.0>;
	turn gun to x-axis <0.0> - pitch speed <280.0>;
	turn radar1 to x-axis <0.0> - pitch speed <280.0>;
	wait-for-turn turret around y-axis;
	wait-for-turn gun around x-axis;
	start-script RestoreAfterDelay();
	return (1);
}

AimFromWeapon1(pieceIndex)
{
	pieceIndex = gun;
}

FireWeapon1()
{
	spin barrel around z-axis speed <900>;
}

QueryWeapon1(pieceIndex)
{
	pieceIndex = flare;
}

Killed(severity, corpsetype)
{
	if( severity <= 25 )
	{
		corpsetype = 1 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode turret type BITMAPONLY | NOHEATCLOUD;
		explode gun type BITMAPONLY | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 50 )
	{
		corpsetype = 2 ;
		explode base type BITMAPONLY | NOHEATCLOUD;
		explode turret type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode gun type FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	if( severity <= 99 )
	{
		corpsetype = 3 ;
		explode base type FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turret type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode gun type SMOKE | FALL | NOHEATCLOUD;
		return(corpsetype);
	}
	corpsetype = 3 ;
		explode base type EXPLODE_ON_HIT | FIRE | SMOKE | FALL | NOHEATCLOUD;
		explode turret type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
		explode gun type EXPLODE_ON_HIT | FIRE | FALL | NOHEATCLOUD;
	return corpsetype;
}
