From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: efrec <quantumscrewdriver@gmail.com>
Date: Mon, 23 Nov 2026 12:41:53 -0500
Subject: [PATCH] lua: add standalone recoil-lua interpreter

recoil-lua compiles the Lua sources that the engine compiles, so scripts run outside the engine with its float lua_Number, streflop math, number formatting, and math.random. No default build includes it; cmake --build --target recoil-lua builds it.

RECOIL_LUA_STANDALONE leaves the handle name and allocator hooks out of LuaUser.cpp, because they need the rest of the engine. init_recoil_lua sets the streflop FPU state, starts spring_time for os.clock, and gives io and os plain libc file access. NOT_USING_CREG keeps spring_time from needing creg.

diff --git a/rts/lib/lua/CMakeLists.txt b/rts/lib/lua/CMakeLists.txt
index da257e6387..b588bab99b 100644
--- a/rts/lib/lua/CMakeLists.txt
+++ b/rts/lib/lua/CMakeLists.txt
@@ -62,3 +62,19 @@ if (CMAKE_CXX_COMPILER_ID MATCHES "Clang")
 		-Wno-empty-body
 	)
 endif()
+
+ADD_EXECUTABLE(recoil-lua EXCLUDE_FROM_ALL
+		${luaSources}
+		"src/lua.cpp"
+		"../../System/Misc/SpringTime.cpp"
+	)
+
+if (ENABLE_STREFLOP)
+TARGET_LINK_LIBRARIES(recoil-lua streflop)
+endif ()
+
+target_compile_definitions(recoil-lua PRIVATE RECOIL_LUA_STANDALONE NOT_USING_CREG)
+
+if (UNIX)
+	target_compile_definitions(recoil-lua PRIVATE LUA_USE_MKSTEMP)
+endif (UNIX)
diff --git a/rts/lib/lua/include/LuaUser.cpp b/rts/lib/lua/include/LuaUser.cpp
index 58538fafb3..ce4620501a 100644
--- a/rts/lib/lua/include/LuaUser.cpp
+++ b/rts/lib/lua/include/LuaUser.cpp
@@ -6,9 +6,11 @@
 #include "lib/streflop/streflop_cond.h"
 
 #include "LuaInclude.h"
+#ifndef RECOIL_LUA_STANDALONE
 #include "Lua/LuaAllocState.h"
 #include "Lua/LuaHandle.h"
 #include "Lua/LuaMemPool.h"
+#endif
 
 #include "System/GlobalRNG.h"
 #include "System/SpringMath.h"
@@ -207,6 +209,7 @@ void LuaMutexYield(lua_State* L)
 
 
 
+#ifndef RECOIL_LUA_STANDALONE
 ///////////////////////////////////////////////////////////////////////////
 //
 
@@ -337,6 +340,7 @@ void spring_lua_alloc_update_stats(int clearStatsFrame)
 	gLuaAllocState.numLuaAllocs.store(gLuaAllocState.numLuaAllocs * (1 - clearStatsFrame));
 	gLuaAllocState.luaAllocTime.store(gLuaAllocState.luaAllocTime * (1 - clearStatsFrame));
 }
+#endif // RECOIL_LUA_STANDALONE
 
 
 
diff --git a/rts/lib/lua/src/lua.cpp b/rts/lib/lua/src/lua.cpp
index 3a46609328..5ef4159741 100644
--- a/rts/lib/lua/src/lua.cpp
+++ b/rts/lib/lua/src/lua.cpp
@@ -17,6 +17,10 @@
 #include "lauxlib.h"
 #include "lualib.h"
 
+/* Recoil */
+#include "lib/streflop/streflop_cond.h"
+#include "System/Misc/SpringTime.h"
+
 
 
 static lua_State *globalL = NULL;
@@ -374,6 +378,21 @@ static int pmain (lua_State *L) {
 }
 
 
+/* Recoil */
+static void init_recoil_lua (lua_State *L) {
+#if STREFLOP_ENABLED
+  streflop::streflop_init<streflop::Simple>();
+#endif
+  /* os.clock */
+  spring_clock::PushTickRate(false);
+  spring_time::setstarttime(spring_time::gettime(true));
+  lua_set_fopen(L, [](lua_State *, const char *path, const char *mode) { return fopen(path, mode); });
+  lua_set_system(L, [](lua_State *, const char *command) { return system(command); });
+  lua_set_remove(L, [](lua_State *, const char *path) { return remove(path); });
+  lua_set_rename(L, [](lua_State *, const char *from, const char *to) { return rename(from, to); });
+}
+
+
 int main (int argc, char **argv) {
   int status;
   struct Smain s;
@@ -382,6 +401,7 @@ int main (int argc, char **argv) {
     l_message(argv[0], "cannot create state: not enough memory");
     return EXIT_FAILURE;
   }
+  init_recoil_lua(L);
   s.argc = argc;
   s.argv = argv;
   status = lua_cpcall(L, &pmain, &s);
