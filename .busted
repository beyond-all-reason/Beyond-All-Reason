-- Discover spec roots generically: the repo spec/ tree plus any module that
-- ships its own spec/ dir (modules are self-contained; no per-module entries).
local function specRoots()
  local roots = { "spec/" }
  local find = io.popen('find modules -mindepth 2 -maxdepth 2 -type d -name spec 2>/dev/null')
  if find then
    for dir in find:lines() do
      roots[#roots + 1] = dir .. "/"
    end
    find:close()
  end
  return roots
end

return {

  default = {
    lpath = lpath,
    helper = "spec/spec_helper.lua",
  },
  -- Default configuration
  verbose = true,
  output = "utfTerminal",
  pattern = "_spec",
  ROOT = specRoots(),

  -- Named tasks
  _all = {
    verbose = true,
    output = "utfTerminal",
    pattern = "_spec",
    helper = "spec/spec_helper.lua",
    ROOT = specRoots()
  },
  unit = {
    verbose = true,
    ROOT = specRoots()
  },
  coverage = {
    verbose = true,
    output = "utfTerminal",
    pattern = "_spec",
    helper = "spec/spec_helper.lua",
    lpath = lpath,
    coverage = true,
    ROOT = specRoots()
  }
}
